{
    admin off
    auto_https disable_redirects
    default_sni 154.8.230.216
    fallback_sni 154.8.230.216
    servers {
        protocols h1 h2
    }
}
https://154.8.230.216 {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            profile shortlived
        }
    }
    handle /terracotta {
        reverse_proxy 127.0.0.1:11011
    }
    @verification path /internal/minecraft/profile
    handle @verification {
        request_body {
            max_size 12KB
        }
        reverse_proxy 127.0.0.1:8765
    }
    handle {
        request_body {
            max_size 1MB
        }
        reverse_proxy 127.0.0.1:8770 {
            header_up X-Forwarded-For {remote_host}
        }
    }
}
# Keep the protected origin compatible while DNS routes for older clients drain.
community-origin.cogniticteam.com {
    handle /terracotta {
        reverse_proxy 127.0.0.1:11011
    }
    @community path /health /v1/community /v1/community/* /internal/minecraft/profile
    handle @community {
        request_body {
            max_size 96KB
        }
        reverse_proxy 127.0.0.1:8765
    }
    handle {
        respond "Not found" 404
    }
}
