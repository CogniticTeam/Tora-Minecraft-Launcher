{
  "name": "tora-launcher-services",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/azure"
  ],
  "scripts": {
    "build:azure": "node apps/azure/build.mjs",
    "dev:api": "wrangler dev --config apps/api/wrangler.toml --env-file apps/.dev.vars",
    "dev:ai": "wrangler dev --config apps/ai/wrangler.toml --env-file apps/.dev.vars",
    "dev:signaling": "wrangler dev --config apps/signaling/wrangler.toml --env-file apps/.dev.vars",
    "deploy:api": "wrangler deploy --config apps/api/wrangler.toml",
    "deploy:ai": "wrangler deploy --config apps/ai/wrangler.toml",
    "deploy:signaling": "wrangler deploy --config apps/signaling/wrangler.toml",
    "deploy:workers": "npm run deploy:api && npm run deploy:ai && npm run deploy:signaling",
    "typecheck:workers": "tsc --noEmit -p tsconfig.workers.json && npm run check:workers",
    "check:workers": "npm run check:api && npm run check:ai && npm run check:signaling",
    "check:api": "wrangler deploy --dry-run --config apps/api/wrangler.toml",
    "check:ai": "wrangler deploy --dry-run --config apps/ai/wrangler.toml",
    "check:signaling": "wrangler deploy --dry-run --config apps/signaling/wrangler.toml",
    "typecheck:tora": "tsc --noEmit -p tsconfig.tora.json",
    "dev:tora": "wrangler dev --config apps/api/wrangler.toml",
    "test:tora": "node --experimental-transform-types --test tora/*.test.ts",
    "build:standalone": "node standalone/build.mjs",
    "test:standalone": "npm run build:standalone && node --experimental-transform-types --test standalone/platform.test.mjs"
  },
  "dependencies": {
    "@waffo/pancake-ts": "^0.16.0",
    "geoip-country": "4.2.262",
    "hono": "4.13.13",
    "mongodb": "6.15.0",
    "node-html-parser": "^6.1.13",
    "semver": "^7.0.0",
    "xxhash-wasm": "^1.1.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "0.28.2",
    "typescript": "^5.5.0",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "ip-address": "10.7.4"
  },
  "license": "AGPL-3.0-only"
}
