[Unit]
Description=TORA community HTTPS (community only)
After=network-online.target tora-community.service
Wants=network-online.target

[Service]
Type=simple
User=tora-community-web
Group=tora-community-web
Environment=HOME=/var/lib/tora-community-web
StateDirectory=tora-community-web
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tora-community-web
ExecStart=/opt/tora-community/bin/caddy run --config /etc/tora-community/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=160M
TasksMax=64
CPUQuota=50%
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
